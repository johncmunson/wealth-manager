# Copy this file to .env.local and fill in the values for your environment.
# This file is safe to commit because it contains keys only, not secrets.

DATABASE_URL=
DATABASE_URL_UNPOOLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
# Sandbox firm-owned Sweep Account used only by `pnpm account:seed`.
ALPACA_SANDBOX_SWEEP_ACCOUNT_ID=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=<openssl rand -base64 32>
