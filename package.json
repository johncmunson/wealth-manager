{
  "name": "wealth-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_ENV=development drizzle-kit migrate",
    "db:migrate:staging": "NODE_ENV=production APP_ENV=staging drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
    "db:push": "NODE_ENV=development drizzle-kit push",
    "db:push:staging": "NODE_ENV=production APP_ENV=staging drizzle-kit push",
    "db:check": "NODE_ENV=development drizzle-kit check",
    "db:check:staging": "NODE_ENV=production APP_ENV=staging drizzle-kit check",
    "db:check:prod": "NODE_ENV=production drizzle-kit check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@next/env": "^16.2.10",
    "@vercel/functions": "^3.7.5",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
